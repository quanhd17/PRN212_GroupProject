<Window x:Class="FinalProject.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:FinalProject.ViewModels"
        xmlns:helpers="clr-namespace:FinalProject.ViewModels.Helpers"
        mc:Ignorable="d"
        d:DesignHeight="800" d:DesignWidth="1200"
        Title="Order Management"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="1000" MinHeight="600">

    <Window.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <helpers:OrderCustomerConverter x:Key="OrderCustomerConverter"/>
        <helpers:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="16,8,16,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding IsNewOrder, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Create New Order|Edit Order'}" 
                               Style="{DynamicResource MaterialDesignHeadline5TextBlock}"/>
                    <TextBlock x:Name="OrderIdText" 
                               Text="{Binding CurrentOrder.OrderId, StringFormat='Order #{0}'}" 
                               Style="{DynamicResource MaterialDesignBody1TextBlock}" 
                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Save Changes" 
                            Command="{Binding SaveOrderCommand}"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Margin="8,0"
                            IsEnabled="{Binding HasUnsavedChanges}"/>
                    <Button Content="Cancel" 
                            Command="{Binding CancelCommand}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Margin="8,0"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Menu Items and Order Items -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Menu Items Section -->
                <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Menu Items" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search menu items..."
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,8,0"/>

                            <Button Grid.Column="1" 
                                    Content="Search" 
                                    Command="{Binding SearchMenuCommand}"
                                    Style="{DynamicResource MaterialDesignRaisedButton}"
                                    Margin="0,0,8,0"/>

                            <TextBox Grid.Column="2" 
                                     Text="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Qty"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Width="60" Margin="0,0,8,0"/>

                            <Button Grid.Column="3" 
                                    Content="Add Selected" 
                                    Command="{Binding AddItemCommand}"
                                    Style="{DynamicResource MaterialDesignRaisedButton}"/>
                        </Grid>

                        <!-- Category Tree and Menu Items -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Category Tree -->
                            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Categories" Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" Margin="0,0,0,8"/>
                                    <TreeView ItemsSource="{Binding CategoryTree}"
                                              SelectedItemChanged="TreeView_SelectedItemChanged"
                                              Style="{DynamicResource MaterialDesignTreeView}">
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding SubCategories}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Folder" Width="16" Height="16" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding CategoryName}"/>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Menu Items Grid -->
                            <materialDesign:Card Grid.Column="1" Margin="8,0,0,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Menu Items" Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding FilteredMenuItems}"
                                              SelectedItem="{Binding SelectedMenuItem}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Style="{DynamicResource MaterialDesignDataGrid}"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              CanUserResizeColumns="True"
                                              CanUserResizeRows="False"
                                              CanUserSortColumns="False"
                                              MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="*"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
                                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category.CategoryName}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Order Items Section -->
                <materialDesign:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Order Items" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16"/>
                        
                        <DataGrid ItemsSource="{Binding OrderItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Style="{DynamicResource MaterialDesignDataGrid}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Item.ItemName}" Width="*"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding ItemPrice, StringFormat=C}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Order Summary -->
                <materialDesign:Card Grid.Row="2" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Order Summary" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" Style="{DynamicResource MaterialDesignBody1TextBlock}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OrderTotal, StringFormat=C}" Style="{DynamicResource MaterialDesignBody1TextBlock}" HorizontalAlignment="Right"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount:" Style="{DynamicResource MaterialDesignBody1TextBlock}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentOrder.Discount, StringFormat={}{0}%}" Style="{DynamicResource MaterialDesignBody1TextBlock}" HorizontalAlignment="Right"/>

                            <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Final Amount:" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OrderFinalAmount, StringFormat=C}" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Right Panel - Order Details -->
            <materialDesign:Card Grid.Column="1" Margin="16,0,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Order Details" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16"/>

                    <!-- Customer Input -->
                    <TextBlock Text="Customer Name" Style="{DynamicResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Enter customer name (leave empty for walk-in)"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,16"/>

                    <!-- Table Selection -->
                    <TextBlock Text="Table" Style="{DynamicResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AvailableTables}"
                              SelectedItem="{Binding SelectedTable}"
                              DisplayMemberPath="TableName"
                              materialDesign:HintAssist.Hint="Select Table"
                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,16"/>

                    <!-- Current Order Info (Read-only) -->
                    <StackPanel>
                        <TextBlock Text="Current Order Information" Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" Margin="0,16,0,8"/>
                        
                        <TextBlock Text="{Binding CurrentOrder.OrderDate, StringFormat='Date: {0:MM/dd/yyyy HH:mm}'}" 
                                   Style="{DynamicResource MaterialDesignBody2TextBlock}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CurrentOrder.Table.TableName, StringFormat='Table: {0}'}" 
                                   Style="{DynamicResource MaterialDesignBody2TextBlock}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CurrentOrder.Customer, Converter={StaticResource OrderCustomerConverter}, StringFormat='Customer: {0}'}" 
                                   Style="{DynamicResource MaterialDesignBody2TextBlock}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CurrentOrder.Status, StringFormat='Status: {0}'}" 
                                   Style="{DynamicResource MaterialDesignBody2TextBlock}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CurrentOrder.TotalAmount, StringFormat='Original Total: {0:C}'}" 
                                   Style="{DynamicResource MaterialDesignBody2TextBlock}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Unsaved Changes Warning -->
                    <materialDesign:Card Margin="0,16,0,0" 
                                        Padding="12" 
                                        Background="{DynamicResource MaterialDesignOrange}"
                                        Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠ Unsaved Changes" 
                                       Style="{DynamicResource MaterialDesignSubtitle2TextBlock}" 
                                       Foreground="White"/>
                            <TextBlock Text="You have unsaved changes. Please save or cancel before leaving." 
                                       Style="{DynamicResource MaterialDesignBody2TextBlock}" 
                                       Foreground="White"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- Bottom Action Bar -->
        <materialDesign:Card Grid.Row="2" Margin="16,0,16,8" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Confirm Changes" 
                        Command="{Binding ConfirmChangesCommand}"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        Margin="8,0"
                        IsEnabled="{Binding HasUnsavedChanges}"/>
                <Button Content="Cancel" 
                        Command="{Binding CancelCommand}"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Margin="8,0"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window> 