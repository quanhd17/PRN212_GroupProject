<Page x:Class="FinalProject.Views.ManageMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewModels="clr-namespace:FinalProject.ViewModels"
      xmlns:helpers="clr-namespace:FinalProject.ViewModels.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Manage Menu"
      Background="{DynamicResource MaterialDesignPaper}"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="13"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      FontFamily="{DynamicResource MaterialDesignFont}">

    <Page.DataContext>
        <viewModels:MenuManagementViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Compact top navbar/header -->
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Staff Dashboard Navbar/Header -->
        <DockPanel Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Height="48">
            <TextBlock Text="Staff Dashboard" Foreground="Orange" FontWeight="Bold" FontSize="18" Margin="16,0" VerticalAlignment="Center"/>
        </DockPanel>

        <materialDesign:Card Grid.Row="1" Margin="16,8,16,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Search -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search menu item by name or description..."
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             Margin="8,0" Width="220"/>
                    <Button Content="Search"
                            Command="{Binding SearchCommand}"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Margin="8,0"/>
                    <!-- Category Filter -->
                    <ComboBox ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                              DisplayMemberPath="CategoryName"
                              materialDesign:HintAssist.Hint="Filter by Category"
                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              Width="140" Margin="8,0"/>
                    <!-- Price Filter -->
                    <TextBox Text="{Binding PriceFilter, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Max Price"
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                             Width="100" Margin="8,0"/>
                    <Button Content="Filter"
                            Command="{Binding FilterCommand}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Margin="8,0"/>
                </StackPanel>
                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Add"
                            Command="{Binding AddMenuItemCommand}"
                            Style="{DynamicResource MaterialDesignRaisedButton}"
                            Margin="4,0"/>
                    <Button Content="Edit"
                            Command="{Binding EditMenuItemCommand}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Margin="4,0"/>
                    <Button Content="Delete"
                            Command="{Binding DeleteMenuItemCommand}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Margin="4,0"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Main Content: Menu List (left) and Item Details (right) -->
        <Grid Grid.Row="2" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Menu Item List (with images) -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="0">
                <StackPanel>
                    <TextBlock Text="Menu Items" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" Margin="16,8,0,8"/>
                    <TabControl Margin="8,0,8,8">
                        <!-- Grid View Tab -->
                        <TabItem Header="Grid View">
                            <Border Height="260" MinHeight="200" MaxHeight="300" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0">
                                <ListBox ItemsSource="{Binding MenuItemList}"
                                         SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,-49">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Margin="6" Padding="10" Width="150" Height="140" Background="White"
                                                    Cursor="Hand">
                                                <StackPanel>
                                                    <Image Source="{Binding ItemUrl}" Height="48" Stretch="Uniform" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding ItemName}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Price, StringFormat='Price: {0:C}'}" FontSize="12" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Category.CategoryName, StringFormat='Category: {0}'}" FontSize="12" Foreground="Gray"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </TabItem>
                        <!-- List View Tab -->
                        <TabItem Header="List View">
                            <ScrollViewer HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto" Height="250">
                                <ListView ItemsSource="{Binding MenuItemList}"
                                          SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                                          Margin="0"
                                          Style="{DynamicResource MaterialDesignListView}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <Image Source="{Binding ItemUrl}" Width="48" Height="48" Margin="0,0,12,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ItemName}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:C}'}" Foreground="Gray" FontSize="12"/>
                                                    <TextBlock Text="{Binding Category.CategoryName}" Foreground="Gray" FontSize="12"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </materialDesign:Card>
            <!-- Menu Item Details Form -->
            <materialDesign:Card Grid.Column="1" Margin="8,0,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Item Details"
                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                               Margin="8,4,8,0"/>
                    <!-- Compact Form Layout -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0" IsEnabled="{Binding IsEditingOrAdding}">
                        <!-- Upload and Preview Row -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Upload Image"
                                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                                    Command="{Binding UploadImageCommand}"
                                    Height="48" Margin="0,0,12,0"/>
                            <Border Grid.Column="1" Width="96" Height="96" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                <Image Source="{Binding ItemImagePath}" Stretch="UniformToFill" Width="96" Height="96"/>
                            </Border>
                        </Grid>
                        <!-- Name (full width) -->
                        <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Item Name"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,6"/>
                        <!-- Price and Category (side by side) -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Price"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                      DisplayMemberPath="CategoryName"
                                      materialDesign:HintAssist.Hint="Category"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"/>
                        </Grid>
                        <!-- Description (full width) -->
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Add description"
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,6" Height="66" AcceptsReturn="True"/>
                        <!-- Available Checkbox aligned with fields -->
                        <CheckBox Content="Available"
                                  IsChecked="{Binding IsAvailable}"
                                  Style="{DynamicResource MaterialDesignCheckBox}"
                                  Margin="8,0,0,4" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Save/Cancel Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Save"
                                Command="{Binding SaveMenuItemCommand}"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Margin="4,0"
                                Visibility="{Binding IsEditingOrAdding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Margin="4,0"
                                Visibility="{Binding IsEditingOrAdding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page> 