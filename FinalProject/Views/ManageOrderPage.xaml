<Page x:Class="FinalProject.Views.ManageOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewModels="clr-namespace:FinalProject.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Manage Orders"
      Background="{DynamicResource MaterialDesignPaper}"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="13"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      FontFamily="{DynamicResource MaterialDesignFont}">

    <Page.DataContext>
        <viewModels:OrderManagementViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and Actions -->
        <materialDesign:Card Grid.Row="0" Margin="16,8,16,0" Padding="12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Order Management" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" Margin="0,0,16,0"/>
                <Button Content="Refresh" Click="Refresh_Click" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Search Orders" 
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                         Width="200" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                          Width="120" Margin="0,0,8,0"/>
                <Button Content="Search" Command="{Binding SearchCommand}" 
                        Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                <Button Content="Filter" Command="{Binding FilterCommand}" 
                        Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                <Button Content="Add" Command="{Binding AddOrderCommand}" 
                        Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                <Button Content="Edit" Command="{Binding EditOrderCommand}" 
                        Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                <Button Content="Save" Command="{Binding SaveOrderCommand}" 
                        Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                
                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        Style="{DynamicResource MaterialDesignOutlinedButton}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Orders DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding OrderList}"
                  SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  Margin="16"
                  IsReadOnly="True"
                  Style="{DynamicResource MaterialDesignDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="*"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding Customer.FirstName}" Width="*"/>
                <DataGridTextColumn Header="Table" Binding="{Binding Table.TableName}" Width="*"/>
                <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount}" Width="*"/>
                <DataGridTextColumn Header="Discount" Binding="{Binding Discount}" Width="*"/>
                <DataGridTextColumn Header="Final" Binding="{Binding FinalAmount}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTemplateColumn Header="Details" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="View" Click="ViewDetails_Click" Tag="{Binding}" Style="{DynamicResource MaterialDesignOutlinedButton}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Delete" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="DeleteOrder_Click" Tag="{Binding}" Style="{DynamicResource MaterialDesignOutlinedButton}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Checkout" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Checkout" Click="CheckoutOrder_Click" Tag="{Binding}" Style="{DynamicResource MaterialDesignOutlinedButton}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page> 