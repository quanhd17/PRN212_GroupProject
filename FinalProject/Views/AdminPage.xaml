<Page x:Class="FinalProject.Views.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FinalProject.Views"
      xmlns:viewModels="clr-namespace:FinalProject.ViewModels"
      xmlns:helpers="clr-namespace:FinalProject.ViewModels.Helpers"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="AdminPage"
      Background="{DynamicResource MaterialDesignPaper}"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="13"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      FontFamily="{DynamicResource MaterialDesignFont}">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:BooleanInverter x:Key="BooleanInverter"/>
    </Page.Resources>

    <Page.DataContext>
        <viewModels:AdminPageViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="16" Padding="16">
            <StackPanel>
                <TextBlock Text="Staff Management" 
                           Style="{DynamicResource MaterialDesignHeadline5TextBlock}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                
                <!-- Search and Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search Box -->
                    <materialDesign:Card Grid.Column="0" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <materialDesign:PackIcon Grid.Column="0" 
                                                   Kind="Magnify" 
                                                   VerticalAlignment="Center" 
                                                   Margin="8,0"/>
                            
                            <TextBox Grid.Column="1" 
                                     Text="{Binding StaffManagementViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search staff by name or username..."
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Margin="8"/>
                            
                            <Button Grid.Column="2" 
                                    Content="Search" 
                                    Command="{Binding StaffManagementViewModel.SearchCommand}"
                                    Style="{DynamicResource MaterialDesignRaisedButton}"
                                    Margin="8,0"/>
                        </Grid>
                    </materialDesign:Card>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Add Staff" 
                                Command="{Binding StaffManagementViewModel.AddStaffCommand}"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Margin="4,0"
                                IsEnabled="{Binding StaffManagementViewModel.IsViewing}"/>
                        <Button Content="Edit Staff" 
                                Command="{Binding StaffManagementViewModel.EditStaffCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Margin="4,0"/>
                        <Button Content="Delete Staff" 
                                Command="{Binding StaffManagementViewModel.DeleteStaffCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Margin="4,0"/>
                        <Button Content="Export to Excel" 
                                Command="{Binding ExportExcelCommand}" 
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Margin="4,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Staff List -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Staff Members" 
                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                               Margin="16"/>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding StaffManagementViewModel.StaffList}"
                              SelectedItem="{Binding StaffManagementViewModel.SelectedStaff, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Style="{DynamicResource MaterialDesignDataGrid}"
                              Margin="16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding AccountId}" Width="60"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding IsBanned}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Staff Details -->
            <materialDesign:Card Grid.Column="1" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Staff Details" 
                               Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                               Margin="16"/>

                    <!-- Details Form -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" IsEnabled="{Binding StaffManagementViewModel.IsEditingOrAdding}">
                            
                            <!-- Username -->
                            <TextBox Text="{Binding StaffManagementViewModel.Username, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Username"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"/>
                            
                            <!-- Password -->
                            <PasswordBox x:Name="PasswordBox"
                                        materialDesign:HintAssist.Hint="Password"
                                        Style="{DynamicResource MaterialDesignOutlinedPasswordBox}"
                                        Margin="0,8"/>
                            
                            <!-- Full Name -->
                            <TextBox Text="{Binding StaffManagementViewModel.FullName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Full Name"
                                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"/>
                            
                            <!-- Role -->
                            <ComboBox ItemsSource="{Binding StaffManagementViewModel.RoleOptions}"
                                      SelectedItem="{Binding StaffManagementViewModel.SelectedRole}"
                                      materialDesign:HintAssist.Hint="Role"
                                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,8"/>
                            
                            <!-- Is Banned -->
                            <CheckBox Content="Account Banned"
                                      IsChecked="{Binding StaffManagementViewModel.IsBanned}"
                                      Style="{DynamicResource MaterialDesignCheckBox}"
                                      Margin="0,8"/>
                            
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
                        <Button Content="Save" 
                                Command="{Binding StaffManagementViewModel.SaveStaffCommand}"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Margin="4,0"
                                Visibility="{Binding StaffManagementViewModel.IsEditingOrAdding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Update" 
                                Command="{Binding StaffManagementViewModel.SaveStaffCommand}"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                Margin="4,0"
                                Visibility="{Binding StaffManagementViewModel.IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Cancel" 
                                Command="{Binding StaffManagementViewModel.CancelCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Margin="4,0"
                                Visibility="{Binding StaffManagementViewModel.IsEditingOrAdding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Cancel" 
                                Command="{Binding StaffManagementViewModel.CancelCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                Margin="4,0"
                                Visibility="{Binding StaffManagementViewModel.IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>
