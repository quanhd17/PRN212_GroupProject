<Page x:Class="FinalProject.Views.OrderListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:viewModels="clr-namespace:FinalProject.ViewModels"
      xmlns:helpers="clr-namespace:FinalProject.ViewModels.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Order List"
      Background="{DynamicResource MaterialDesignPaper}"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="13"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      FontFamily="{DynamicResource MaterialDesignFont}">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <helpers:OrderCustomerConverter x:Key="OrderCustomerConverter"/>
    </Page.Resources>

    <Page.DataContext>
        <viewModels:OrderListViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Margin="16,8,16,0" Padding="12">
            <TextBlock Text="Order Management" Style="{DynamicResource MaterialDesignHeadline6TextBlock}"/>
        </materialDesign:Card>

        <!-- Filter Controls -->
        <materialDesign:Card Grid.Row="1" Margin="16,8,16,0" Padding="16">
            <StackPanel>
                <TextBlock Text="Filter Orders" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Date Range -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
                        <TextBlock Text="Start Date" Style="{DynamicResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" 
                                   Style="{DynamicResource MaterialDesignOutlinedDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="8,0">
                        <TextBlock Text="End Date" Style="{DynamicResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" 
                                   Style="{DynamicResource MaterialDesignOutlinedDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="8,0">
                        <TextBlock Text="Status" Style="{DynamicResource MaterialDesignCaptionTextBlock}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                                  Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                                  IsEnabled="{Binding ShowAllStatuses, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Grid.Row="0" Margin="8,0" VerticalAlignment="Bottom">
                        <CheckBox Content="Show All Statuses" 
                                  IsChecked="{Binding ShowAllStatuses, Mode=TwoWay}"
                                  Style="{DynamicResource MaterialDesignCheckBox}"/>
                    </StackPanel>

                    <!-- Search and Action Buttons -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Search by Order ID, Customer, Table, or Staff" 
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                 Width="300" Margin="0,0,8,0"/>
                        <Button Content="Search" Command="{Binding FilterOrdersCommand}" 
                                Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                        <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" 
                                Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Create New Order" Command="{Binding CreateNewOrderCommand}" 
                                Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                        <Button Content="View Details" Command="{Binding ViewOrderDetailsCommand}" 
                                Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                        <Button Content="Edit Order" Command="{Binding EditOrderCommand}" 
                                Style="{DynamicResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                        <Button Content="Refresh" Command="{Binding LoadOrdersCommand}" 
                                Style="{DynamicResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Order List -->
        <materialDesign:Card Grid.Row="2" Margin="16,8,16,0" Padding="16">
            <StackPanel>
                <TextBlock Text="Order List" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16"/>
                
                <DataGrid ItemsSource="{Binding OrderList}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{DynamicResource MaterialDesignDataGrid}"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="80"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=MM/dd/yyyy HH:mm}" Width="120"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer, Converter={StaticResource OrderCustomerConverter}}" Width="150"/>
                        <DataGridTextColumn Header="Table" Binding="{Binding Table.TableName}" Width="80"/>
                        <DataGridTextColumn Header="Staff" Binding="{Binding Account.FullName}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Items Count" Binding="{Binding OrderItems.Count}" Width="80"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="120"/>
                        <DataGridTextColumn Header="Final Amount" Binding="{Binding FinalAmount, StringFormat=C}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Page> 